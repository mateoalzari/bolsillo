# Copiá este archivo como .env.local y completá con los datos de tu proyecto de Supabase
# (Project Settings → API Keys). La publishable key es pública: está pensada para el navegador
# y los datos quedan protegidos por Row Level Security. NUNCA pongas acá la secret key.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
